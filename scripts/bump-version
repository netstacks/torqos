#!/usr/bin/env bash
# Set TorqOS's version, everywhere it is written, before a release is tagged.
#
#   scripts/bump-version 0.2.0            # set it, and check every place agrees
#   scripts/bump-version 0.2.0 --commit   # and commit it (signed off), ready to tag
#
# The version a machine reports (/etc/os-release, the console and SSH greetings) is torqcli's, from
# cli/Cargo.toml; the broker carries the same. Each crate's Cargo.lock names it too, and
# package.nix reads it from Cargo.toml. The release workflow refuses a tag that is not
# `v<this version>` (or `v<this version>-<pre-release>`, e.g. v0.2.0-rc1, which needs no bump).
# Run from anywhere in the repository; it changes nothing outside cli/ and broker/.
set -euo pipefail

usage() { echo "usage: scripts/bump-version <major.minor.patch> [--commit]" >&2; exit 2; }
[ $# -ge 1 ] && [ $# -le 2 ] || usage
new=$1
commit=${2:-}
[ -z "$commit" ] || [ "$commit" = --commit ] || usage
[[ $new =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "not a version: $new (major.minor.patch, e.g. 0.2.0; a pre-release is a tag, v0.2.0-rc1)" >&2; exit 2; }

cd "$(git rev-parse --show-toplevel)"
crates=(cli broker)

# The version in a Cargo.toml's [package] section.
toml_version() { awk '/^\[/{p = ($0 == "[package]")} p && /^version *=/ {gsub(/[" ]/, "", $0); sub(/^version=/, "", $0); print; exit}' "$1"; }
toml_name() { awk '/^\[/{p = ($0 == "[package]")} p && /^name *=/ {gsub(/[" ]/, "", $0); sub(/^name=/, "", $0); print; exit}' "$1"; }
# The version Cargo.lock records for package `name`.
lock_version() { awk -v n="$2" '$0 == "name = \"" n "\"" {f = 1; next} f && /^version = / {gsub(/"/, "", $3); print $3; exit}' "$1"; }

old=$(toml_version cli/Cargo.toml)
if [ "$old" = "$new" ]; then echo "Already $new."; fi

if [ -n "$commit" ] && ! git diff --quiet HEAD -- "${crates[@]/%//Cargo.toml}" "${crates[@]/%//Cargo.lock}"; then
  echo "cli/ or broker/'s Cargo files have changes not committed: commit or drop them first." >&2; exit 1
fi

for c in "${crates[@]}"; do
  name=$(toml_name "$c/Cargo.toml")
  # [package]'s version line only, never a dependency's.
  awk -v v="$new" '/^\[/{p = ($0 == "[package]")} p && !done && /^version *=/ {print "version = \"" v "\""; done = 1; next} {print}' \
    "$c/Cargo.toml" > "$c/Cargo.toml.new" && mv "$c/Cargo.toml.new" "$c/Cargo.toml"
  # The lock's entry for this crate itself: its version line, right after its name.
  awk -v n="$name" -v v="$new" '$0 == "name = \"" n "\"" {print; f = 1; next} f && /^version = / {print "version = \"" v "\""; f = 0; next} {print}' \
    "$c/Cargo.lock" > "$c/Cargo.lock.new" && mv "$c/Cargo.lock.new" "$c/Cargo.lock"
done

# Every place agrees, as Nix and the release will read them.
bad=0
for c in "${crates[@]}"; do
  name=$(toml_name "$c/Cargo.toml")
  for got in "$(toml_version "$c/Cargo.toml")" "$(lock_version "$c/Cargo.lock" "$name")"; do
    [ "$got" = "$new" ] || { echo "$c: found $got, not $new" >&2; bad=1; }
  done
done
for p in torq torq-broker; do
  got=$(nix eval --raw ".#packages.$(nix eval --raw --impure --expr builtins.currentSystem).$p.version" 2>/dev/null || echo "(no evaluation)")
  [ "$got" = "$new" ] || { echo "$p's package says $got, not $new" >&2; bad=1; }
done
[ $bad -eq 0 ] || exit 1
echo "TorqOS is $new (was $old): cli and broker, their Cargo.toml and Cargo.lock, and their packages."

if [ -n "$commit" ]; then
  git add "${crates[@]/%//Cargo.toml}" "${crates[@]/%//Cargo.lock}"
  git commit -q -s -m "TorqOS $new" -m "The version a machine reports (os-release, the greetings): scripts/bump-version $new."
  echo "Committed: $(git log --oneline -1)"
fi
cat <<EOF

To release it, once this is on main and CI is green there:
  git tag -a v$new -m "TorqOS v$new" && git push origin v$new
or a pre-release first (stable does not move): git tag -a v$new-rc1 -m "TorqOS v$new-rc1" && git push origin v$new-rc1
EOF
